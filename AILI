  }
  document.getElementById('search').value = "";
  document.getElementById('category').value = 'all';
  document.getElementById('worldFilter').value = 'all';
  document.getElementById('sizeFilter').value = 'all';
  document.getElementById('priceFilter').value = 'all';
  document.getElementById('sort').value = 'featured';
  document.querySelectorAll('.shopnavitem').forEach(x => x.classList.remove('active'));
  document.getElementById('productGrid').innerHTML = favs.map(card).join('');
