let cart = JSON.parse(localStorage.getItem('ailiCart') || '[]');
let wishlist = JSON.parse(localStorage.getItem('ailiWishlist') || '[]');
let currentUser = JSON.parse(localStorage.getItem('ailiUser') || 'null');
let allOrders = JSON.parse(localStorage.getItem('ailiOrders') || '[]');
let selectedProduct = null;
let selectedSize = null;
let modalQty = 1;
let selectedPaymentMethod = 'Tarjeta de Crédito Principal';

function money(n){
  return new Intl.NumberFormat('es-MX',{
    style:'currency',
    currency: 'MXN'
  }).format(n);
}

function save(){
  localStorage.setItem('ailiCart', JSON.stringify(cart));
  localStorage.setItem('ailiWishlist', JSON.stringify(wishlist));
  localStorage.setItem('ailiUser', JSON.stringify(currentUser));
  localStorage.setItem('ailiOrders', JSON.stringify(allOrders));
  updateCartCount();
  updateUserUI();
}

function updateCartCount(){
  document.getElementById('cartCount').textContent = cart.reduce((a,x)=>a+x.cantidad,0);
}

function updateUserUI(){
  const btn = document.getElementById('userSessionBtn');
  if(currentUser){
    if(currentUser.role === 'admin'){
      btn.textContent = 'Admin';
      btn.onclick = openAdminModal;
    } else {
      btn.textContent = currentUser.name;
      btn.onclick = openUserAccount;
    }
  } else {
    btn.textContent = 'Acceder';
    btn.onclick = openLoginModal;
  }
}

function openLoginModal(){
  document.getElementById('loginModal').classList.add('open');
  document.getElementById('overlay').classList.add('open');
  document.body.classList.add('lock');
}

function closeLoginModal(){
  document.getElementById('loginModal').classList.remove('open');
  document.getElementById('overlay').classList.remove('open');
  document.body.classList.remove('lock');
}

function handleLoginSubmit(e){
  e.preventDefault();
  const userVal = document.getElementById('loginUser').value.trim();
  const passVal = document.getElementById('loginPass').value.trim();
  if(userVal === 'admin' && passVal === 'admin123'){
    currentUser = { name: 'Administrador', email: 'admin@aili.com', role: 'admin' };
    showToast('¡Bienvenido, Administrador!');
    closeLoginModal();
    save();
    openAdminModal();
  } else {
    currentUser = { name: userVal.split('@')[0], email: userVal, role: 'client' };
    showToast('¡Sesión iniciada con éxito!');
    closeLoginModal();
    save();
  }
}

function openUserAccount(){
  showToast(`Conectado como: ${currentUser.email}`);
}

function openAdminModal(){
  if(!currentUser || currentUser.role !== 'admin'){
    openLoginModal();
    return;
  }
  const listContainer = document.getElementById('adminOrdersList');
  if(allOrders.length === 0){
    listContainer.innerHTML = '<p style="color:var(--muted); font-size:13px; text-align:center;">No hay pedidos registrados todavía.</p>';
  } else {
    listContainer.innerHTML = allOrders.map(o => `
      <div style="border-bottom: 1px solid var(--line); padding: 8px 0; font-size: 12px;">
        <strong>Pedido:</strong> ${o.id} | <strong>Cliente:</strong> ${o.name} (${o.email})<br>
        <strong>Método:</strong> ${o.payment} | <strong>Total:</strong> <span style="color: var(--gold);">${money(o.total)}</span>
      </div>
    `).join('');
  }
  document.getElementById('adminModal').classList.add('open');
  document.getElementById('overlay').classList.add('open');
  document.body.classList.add('lock');
}

function closeAdminModal(){
  document.getElementById('adminModal').classList.remove('open');
  document.getElementById('overlay').classList.remove('open');
  document.body.classList.remove('lock');
}

function adminLogout(){
  currentUser = null;
  save();
  closeAdminModal();
  showToast('Sesión de administrador cerrada');
}

function renderProducts(){
  const search = document.getElementById('search').value.toLowerCase().trim();
  const category = document.getElementById('category').value;
  const world = document.getElementById('worldFilter').value;
  const size = document.getElementById('sizeFilter').value;
  const price = document.getElementById('priceFilter').value;
  const sort = document.getElementById('sort').value;

  let list = PRODUCTS.filter(p => {
    const searchable = [
      p.name,
      p.category,
      ...p.worlds
    ].join(' ').toLowerCase();

    const matchesSearch = !search || searchable.includes(search);
    const matchesCategory = category === 'all' || p.category === category;
    const matchesWorld = world === 'all' || p.worlds.includes(world);
    const matchesSize = size === 'all' || p.sizes.includes(size);

    let matchesPrice = true;
    if(price === 'under1500') matchesPrice = p.price < 1500;
    if(price === '1500-3000') matchesPrice = p.price >= 1500 && p.price <= 3000;
    if(price === 'over3000') matchesPrice = p.price > 3000;

    return matchesSearch && matchesCategory && matchesWorld && matchesSize && matchesPrice;
  });

  if(sort === 'low') list.sort((a,b)=>a.price-b.price);
  if(sort === 'high') list.sort((a,b)=>b.price-a.price);
  if(sort === 'name') list.sort((a,b)=>a.name.localeCompare(b.name));

  document.getElementById('resultCount').textContent = `${list.length} piezas`;
  document.getElementById('productGrid').innerHTML = list.length
    ? list.map(card).join('')
    : '<div class="empty">No encontramos piezas con estos filtros.</div>';
}

function setShop(cat){
  document.getElementById('category').value = cat;
  document.getElementById('worldFilter').value = 'all';
  document.querySelectorAll('.shopnavitem').forEach(x => {
    x.classList.toggle('active', x.dataset.shop === cat);
  });
  renderProducts();
  document.getElementById('tienda').scrollIntoView({behavior: 'smooth'});
}

function setWorld(world){
  document.getElementById('worldFilter').value = world;
  document.getElementById('category').value = 'all';
  document.querySelectorAll('.shopnavitem').forEach(x => {
    x.classList.remove('active');
  });
  renderProducts();
  document.getElementById('tienda').scrollIntoView({behavior: 'smooth'});
}

function resetFilters(){
  document.getElementById('search').value = "";
  document.getElementById('category').value = 'all';
  document.getElementById('worldFilter').value = 'all';
  document.getElementById('sizeFilter').value = 'all';
  document.getElementById('priceFilter').value = 'all';
  document.getElementById('sort').value = 'featured';
  document.querySelectorAll('.shopnavitem').forEach(x => {
    x.classList.toggle('active', x.dataset.shop === 'all');
  });
  renderProducts();
}

function categoryLabel(category){
  if(category === 'ropa') return 'Clothing';
  if(category === 'calzado') return 'Shoes';
  if(category === 'bolsos') return 'Bags';
  if(category === 'joyeria') return 'Jewelry';
  return 'Accessories';
}

function card(p){
  const fav = wishlist.includes(p.id);
  const fallbackAttr = p.fallbackImg ? `onerror="this.onerror=null;this.src='${p.fallbackImg}'"` : '';
  return `
    <article class="product">
      <div class="productimg">
        <img src="${p.img}" ${fallbackAttr} alt="${p.name}">
        ${p.stock <= 5 ? '<span class="badge">Últimas piezas</span>' : ''}
        <button class="heart ${fav ? 'active' : ''}" onclick="toggleWish('${p.id}')">♡</button>
      </div>
      <div class="productbody">
        <span class="category">
          ${categoryLabel(p.category)} • ${p.worlds[0]}
        </span>
        <h3>${p.name}</h3>
        <div class="price">${money(p.price)}</div>
        <div class="stock">
          ${p.stock > 0 ? 'Disponible' : 'Agotado'}
        </div>
        <div class="product-actions">
          <button class="goldbtn" onclick="openProduct('${p.id}')">
            Ver pieza
          </button>
        </div>
      </div>
    </article>
  `;
}

function openProduct(id){
  selectedProduct = PRODUCTS.find(p => p.id === id);
  if(!selectedProduct) return;
  selectedSize = null;
  modalQty = 1;
  const fallbackAttr = selectedProduct.fallbackImg ? `onerror="this.onerror=null;this.src='${selectedProduct.fallbackImg}'"` : '';
  document.getElementById('modalContent').innerHTML = `
    <div class="modalimage">
      <img src="${selectedProduct.img}" ${fallbackAttr} alt="${selectedProduct.name}">
    </div>
    <div class="modalinfo">
      <span class="category">
        ${categoryLabel(selectedProduct.category)} • ${selectedProduct.worlds.join(', ')} • ${selectedProduct.id}
      </span>
      <h2>${selectedProduct.name}</h2>
      <div class="modalprice">
        ${money(selectedProduct.price)}
      </div>
      <p class="modaldesc" style="white-space: pre-line;">
        ${selectedProduct.desc}
      </p>
      <span class="label">Selecciona tu talla</span>
      <div class="sizes">
        ${selectedProduct.sizes.map(s => `
          <button class="size" onclick="chooseSize('${s}')">
            ${s}
          </button>
        `).join('')}
      </div>
      <span class="label">Cantidad</span>
      <div class="quantity">
        <button onclick="changeModalQty(-1)">-</button>
        <span id="modalQty">1</span>
        <button onclick="changeModalQty(1)">+</button>
      </div>
      <button class="goldbtn full" onclick="addSelectedToCart()">
        Añadir a la bolsa
      </button>
      <div class="notice">
        ${selectedProduct.stock} unidades disponibles.
      </div>
    </div>
  `;
  document.getElementById('productModal').classList.add('open');
  document.getElementById('overlay').classList.add('open');
  document.body.classList.add('lock');
}

function chooseSize(s){
  selectedSize = s;
  document.querySelectorAll('.size').forEach(b => {
    b.classList.toggle('selected', b.textContent.trim() === s);
  });
}

function changeModalQty(n){
  modalQty = Math.max(1, Math.min(selectedProduct.stock, modalQty + n));
  document.getElementById('modalQty').textContent = modalQty;
}

function addSelectedToCart(){
  if(!selectedSize){
    showToast('Selecciona una talla para continuar');
    return;
  }
  addToCart(selectedProduct, selectedSize, modalQty);
  closeProduct();
}

function addToCart(p, size, qty){
  const available = p.stock;
  const existing = cart.find(x => x.id === p.id && x.tallaSeleccionada === size);
  const current = existing ? existing.cantidad : 0;
  if(current + qty > available){
    showToast('No hay suficientes unidades disponibles');
    return;
  }
  if(existing){
    existing.cantidad += qty;
  }else{
    cart.push({
      id: p.id,
      nombre: p.name,
      precioUnitario: p.price,
      tallaSeleccionada: size,
      cantidad: qty,
      fechaHoraAgregado: new Date().toISOString(),
      disponibleEnInventario: true,
      img: p.img,
      fallbackImg: p.fallbackImg || ''
    });
  }
  save();
  showToast('Añadido a tu bolsa');
  renderCart();
}

function renderCart(){
  const el = document.getElementById('cartItems');
  if(!cart.length){
    el.innerHTML = `
      <div class="cartempty">
        Tu bolsa está esperando algo especial.<br>
        <a href="#tienda" onclick="closeCart()" style="color:var(--gold)">
          Explorar colección
        </a>
      </div>
    `;
    document.getElementById('cartTotal').textContent = money(0);
    return;
  }
  el.innerHTML = cart.map((x,i) => {
    const fallbackAttr = x.fallbackImg ? `onerror="this.onerror=null;this.src='${x.fallbackImg}'"` : '';
    return `
      <div class="cartitem">
        <img src="${x.img}" ${fallbackAttr} alt="${x.nombre}">
        <div class="cartinfo">
          <h3>${x.nombre}</h3>
          <div class="cartmeta">
            Talla ${x.tallaSeleccionada} • ${money(x.precioUnitario)}
          </div>
          <div class="qty">
            <button onclick="changeCartQty(${i}, -1)">-</button>
            <span>${x.cantidad}</span>
            <button onclick="changeCartQty(${i}, 1)">+</button>
          </div>
          <button class="remove" onclick="removeCart(${i})">
            Eliminar
          </button>
        </div>
        <div class="cartprice">
          ${money(x.precioUnitario * x.cantidad)}
        </div>
      </div>
    `;
  }).join('');
  document.getElementById('cartTotal').textContent = money(
    cart.reduce((a,x) => a + x.precioUnitario * x.cantidad, 0)
  );
}

function changeCartQty(i, n){
  const x = cart[i];
  const p = PRODUCTS.find(prod => prod.id === x.id);
  x.cantidad += n;
  if(x.cantidad <= 0){
    cart.splice(i, 1);
  }else if(x.cantidad > p.stock){
    x.cantidad = p.stock;
    showToast('Llegaste al límite disponible');
  }
  save();
  renderCart();
}

function removeCart(i){
  cart.splice(i, 1);
  save();
  renderCart();
}

