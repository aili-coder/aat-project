/* ============================================================================
   LÓGICA DEL ASISTENTE DE ESTILO Y COTIZACIÓN CON IA (GEMINI + RESPALDO LOCAL)
   ============================================================================ */
let aiHistory = [];

function openAiAssistant(){
  closeCart();
  document.getElementById('aiDrawer').classList.add('open');
  document.getElementById('overlay').classList.add('open');
  document.body.classList.add('lock');
  setTimeout(() => document.getElementById('aiPromptInput').focus(), 200);
}

function closeAiAssistant(){
  document.getElementById('aiDrawer').classList.remove('open');
  if(!document.getElementById('cartDrawer').classList.contains('open') &&
     !document.getElementById('productModal').classList.contains('open') &&
     !document.getElementById('loginModal').classList.contains('open') &&
     !document.getElementById('adminModal').classList.contains('open')){
    document.getElementById('overlay').classList.remove('open');
    document.body.classList.remove('lock');
  }
}

function sendQuickPrompt(text){
  document.getElementById('aiPromptInput').value = text;
  handleAiSubmit(new Event('submit'));
}

function addAllRecommendedToCart(ids){
  let added = 0;
  ids.forEach(id => {
    const prod = PRODUCTS.find(p => p.id === id);
    if(prod && prod.stock > 0){
      const defaultSize = prod.sizes.includes('M') ? 'M' : prod.sizes[0];
      addToCart(prod, defaultSize, 1);
      added++;
    }
  });
  if(added > 0){
    showToast(`${added} pieza(s) del look añadidas a tu bolsa`);
  }
}

function quickAddSingleFromAi(id){
  const prod = PRODUCTS.find(p => p.id === id);
  if(!prod) return;
  if(prod.sizes.length === 1 && prod.sizes[0] === 'Única'){
    addToCart(prod, 'Única', 1);
  } else {
    closeAiAssistant();
    openProduct(id);
  }
}

async function handleAiSubmit(e){
  e.preventDefault();
  const input = document.getElementById('aiPromptInput');
  const sendBtn = document.getElementById('aiSendBtn');
  const messagesBox = document.getElementById('aiMessages');
  const userText = input.value.trim();
  if(!userText) return;

  input.value = '';
  sendBtn.disabled = true;

  // Render mensaje del usuario
  const userDiv = document.createElement('div');
  userDiv.className = 'ai-msg user';
  userDiv.textContent = userText;
  messagesBox.appendChild(userDiv);

  // Indicador de carga
  const typingDiv = document.createElement('div');
  typingDiv.className = 'ai-typing';
  typingDiv.textContent = '✦ Analizando catálogo, tallas y cotización...';
  messagesBox.appendChild(typingDiv);
  messagesBox.scrollTop = messagesBox.scrollHeight;

  aiHistory.push({ role: 'user', text: userText });

  try {
    const responseData = await queryAiliStylist(userText);
    typingDiv.remove();
    renderAiResponse(responseData);
    aiHistory.push({ role: 'assistant', text: responseData.message });
  } catch (err) {
    typingDiv.remove();
    const fallbackData = localStylistFallback(userText);
    renderAiResponse(fallbackData);
  } finally {
    sendBtn.disabled = false;
    messagesBox.scrollTop = messagesBox.scrollHeight;
  }
}

async function queryAiliStylist(userMessage){
  const catalogSummary = PRODUCTS.map(p => ({
    id: p.id,
    name: p.name,
    priceMXN: p.price,
    category: p.category,
    worlds: p.worlds,
    sizes: p.sizes,
    stock: p.stock,
    desc: p.desc.split('\n')[0]
  }));

  const systemInstruction = `Eres "AILI Stylist IA", el asesor experto de moda, estilismo personal y cotizaciones de la marca de lujo contemporáneo AILI ("WHO WILL YOU BE TODAY?").
Tu misión:
1. Recomendar outfits completos o piezas específicas según el evento, ocasión, clima, estilo o presupuesto del cliente.
2. Hacer cotizaciones exactas en Pesos Mexicanos (MXN) sumando únicamente los precios reales del catálogo disponible.
3. Si el cliente indica un presupuesto máximo, ajusta la selección para respetar ese límite y muestra el desglose claro.
4. Mantén un tono editorial, sofisticado, cálido y directo en español.

Catálogo oficial disponible de AILI (JSON):
${JSON.stringify(catalogSummary)}

Responde ÚNICAMENTE con un objeto JSON válido con la siguiente estructura exacta (sin bloques markdown):
{
  "message": "Explicación editorial de tu recomendación, por qué funciona para la ocasión y el desglose de precios en MXN.",
  "recommendedIds": ["AILI-001", "AILI-010"],
  "quoteTotal": 4650,
  "occasionTag": "GALA NOCTURNA"
}`;

  const apiKey = "";
  const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`;

  const payload = {
    systemInstruction: { parts: [{ text: systemInstruction }] },
    contents: aiHistory.slice(-6).map(m => ({
      role: m.role === 'assistant' ? 'model' : 'user',
      parts: [{ text: m.text }]
    })),
    generationConfig: {
      temperature: 0.4,
      responseMimeType: "application/json"
    }
  };

  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  });

  if(!res.ok) throw new Error('API unavailable');
  const data = await res.json();
  const rawText = data.candidates?.[0]?.content?.parts?.[0]?.text || '{}';
  const parsed = JSON.parse(rawText);

  const validIds = (parsed.recommendedIds || []).filter(id => PRODUCTS.some(p => p.id === id));
  const exactTotal = validIds.reduce((sum, id) => {
    const item = PRODUCTS.find(p => p.id === id);
    return sum + (item ? item.price : 0);
  }, 0);

  return {
    message: parsed.message || 'Aquí tienes una selección curada de piezas AILI para tu ocasión.',
    recommendedIds: validIds,
    quoteTotal: exactTotal,
    occasionTag: parsed.occasionTag || 'CURADURÍA AILI'
  };
}

function localStylistFallback(query){
  const q = query.toLowerCase();
  const budgetMatch = q.match(/\$?\s*(\d[\d,\.]*)/);
  const maxBudget = budgetMatch ? parseFloat(budgetMatch[1].replace(/,/g, '')) : null;

  let picks = [];
  let tag = 'ESTILISMO AILI';
  let intro = '';

  if(q.includes('gala') || q.includes('noche') || q.includes('boda') || q.includes('elegante')){
    tag = 'EVENING & GALA';
    picks = ['AILI-001', 'AILI-010', 'AILI-014'];
    intro = 'Para una ocasión nocturna de alto impacto, te sugiero el movimiento fluido del AILI Emerald Flow Long Dress combinado con nuestras sandalias doradas y aretes celestiales.';
  } else if(q.includes('formal') || q.includes('oficina') || q.includes('ejecutiv') || q.includes('reunion')){
    tag = 'FORMAL & ATELIER';
    picks = ['AILI-007', 'AILI-008', 'AILI-011', 'AILI-013'];
    intro = 'Para proyectar seguridad y sofisticación contemporánea, esta combinación sastre equilibra estructura impecable con comodidad durante todo el día.';
  } else if(q.includes('joyer') || q.includes('accesorio') || q.includes('complemento')){
    tag = 'ACCENTS & JEWELRY';
    picks = ['AILI-014', 'AILI-015', 'AILI-016', 'AILI-017'];
    intro = 'Los detalles transforman cualquier silueta. Estas piezas de joyería y accesorios están diseñadas para elevar tanto looks minimalistas como vestidos de noche.';
  } else {
    tag = 'EVERYDAY STATEMENT';
    picks = ['AILI-002', 'AILI-011', 'AILI-018'];
    intro = 'Una propuesta versátil y expresiva con silueta asimétrica, calzado arquitectónico y gafas cat-eye ideal para destacar de día o en eventos casual-chic.';
  }

  if(maxBudget && maxBudget >= 890){
    const sorted = [...PRODUCTS].sort((a,b) => a.price - b.price);
    let running = 0;
    const budgetPicks = [];
    for(const item of sorted){
      if(running + item.price <= maxBudget && budgetPicks.length < 3){
        budgetPicks.push(item.id);
        running += item.price;
      }
    }
    if(budgetPicks.length > 0){
      picks = budgetPicks;
      tag = `PRESUPUESTO ${money(maxBudget)}`;
      intro = `He optimizado esta selección para respetar tu presupuesto de ${money(maxBudget)} MXN sin sacrificar estilo ni presencia.`;
    }
  }

  const total = picks.reduce((acc, id) => {
    const p = PRODUCTS.find(x => x.id === id);
    return acc + (p ? p.price : 0);
  }, 0);

  return {
    message: intro,
    recommendedIds: picks,
    quoteTotal: total,
    occasionTag: tag
  };
}

function renderAiResponse(data){
  const messagesBox = document.getElementById('aiMessages');
  const cardDiv = document.createElement('div');
  cardDiv.className = 'ai-msg assistant';

  const itemsHtml = (data.recommendedIds || []).map(id => {
    const p = PRODUCTS.find(prod => prod.id === id);
    if(!p) return '';
    const fallbackAttr = p.fallbackImg ? `onerror="this.onerror=null;this.src='${p.fallbackImg}'"` : '';
    return `
      <div class="ai-rec-card">
        <img src="${p.img}" ${fallbackAttr} alt="${p.name}">
        <div class="ai-rec-info">
          <h4>${p.name}</h4>
          <span>${money(p.price)}</span>
          <small>${categoryLabel(p.category)} • ${p.stock} disp.</small>
        </div>
        <div class="ai-rec-actions">
          <button class="ai-mini-btn" onclick="closeAiAssistant(); openProduct('${p.id}')">Ver</button>
          <button class="ai-mini-btn gold" onclick="quickAddSingleFromAi('${p.id}')">+ Bolsa</button>
        </div>
      </div>
    `;
  }).join('');

  const idsJson = JSON.stringify(data.recommendedIds || []).replace(/"/g, '"');

  const quoteHtml = (data.recommendedIds && data.recommendedIds.length > 0) ? `
    <div class="ai-quote-box">
      <div>
        <span>Cotización total (${data.recommendedIds.length} piezas)</span>
        <strong>${money(data.quoteTotal)} MXN</strong>
      </div>
      <button class="goldbtn" style="padding: 0 12px; min-height: 36px; font-size: 10px;" onclick="addAllRecommendedToCart(${idsJson})">
        Añadir look
      </button>
    </div>
  ` : '';

  cardDiv.innerHTML = `
    <div class="ai-msg-header">
      <span>AILI STYLIST IA</span>
      <span>${data.occasionTag || 'COTIZACIÓN'}</span>
    </div>
    <div style="white-space: pre-line;">${data.message}</div>
    ${itemsHtml ? `<div class="ai-rec-list">${itemsHtml}</div>` : ''}
    ${quoteHtml}
  `;

  messagesBox.appendChild(cardDiv);
}

